diff --git a/src/metal/metal-device.cpp b/src/metal/metal-device.cpp
index 1286e9e..391b950 100644
--- a/src/metal/metal-device.cpp
+++ b/src/metal/metal-device.cpp
@@ -461,11 +461,30 @@ NS::Array* DeviceImpl::getAccelerationStructureArray()
 {
     if (m_accelerationStructures.arrayDirty)
     {
+        // Freed slots hold nullptr until reused, and an NSArray cannot hold
+        // nil: -initWithObjects:count: throws, unwinding past an open
+        // acceleration structure encoder. No live instance refers to a freed
+        // slot; each gets an empty placeholder structure of its own, so the
+        // array stays one distinct object per index.
+        std::vector<MTL::AccelerationStructure*> objects;
+        objects.reserve(m_accelerationStructures.list.size());
+        size_t placeholder = 0;
+        for (auto* as : m_accelerationStructures.list)
+        {
+            if (!as)
+            {
+                if (placeholder == m_accelerationStructures.placeholders.size())
+                {
+                    m_accelerationStructures.placeholders.push_back(
+                        NS::TransferPtr(m_device->newAccelerationStructure(NS::UInteger(64)))
+                    );
+                }
+                as = m_accelerationStructures.placeholders[placeholder++].get();
+            }
+            objects.push_back(as);
+        }
         m_accelerationStructures.array = NS::TransferPtr(
-            NS::Array::alloc()->init(
-                (const NS::Object* const*)m_accelerationStructures.list.data(),
-                m_accelerationStructures.list.size()
-            )
+            NS::Array::alloc()->init((const NS::Object* const*)objects.data(), objects.size())
         );
         m_accelerationStructures.arrayDirty = false;
     }
